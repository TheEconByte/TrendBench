generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  plans         Plan[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Plan {
  id                 String       @id @default(cuid())
  userId             String
  title              String
  inputJson          Json         @db.JsonB
  inputSchemaVersion String
  revision           Int          @default(1)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  results            PlanResult[]

  @@index([userId, updatedAt])
  @@map("plans")
}

model PlanResult {
  id                 String   @id @default(cuid())
  planId             String
  inputRevision      Int
  inputSchemaVersion String
  inputSnapshot      Json     @db.JsonB
  resultJson         Json     @db.JsonB
  calculationVersion String
  calculationKey     String   @unique
  calculatedAt       DateTime @default(now())
  plan               Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, inputRevision, inputSchemaVersion, calculationVersion])
  @@index([planId, calculatedAt])
  @@map("plan_results")
}

enum MarketReleaseStatus {
  PENDING
  ACTIVE
  SUPERSEDED
  FAILED
}

// One official data bundle. Only a fully validated release becomes ACTIVE, and
// activating a new release only flips status so older rows stay readable.
model MarketRelease {
  id                String              @id @default(cuid())
  releaseKey        String              @unique
  label             String
  status            MarketReleaseStatus @default(PENDING)
  schemaVersion     String
  definitionVersion String
  sourceUrl         String
  basisPeriod       String
  basisPeriodLabel  String
  retrievedAt       DateTime
  files             Json                @db.JsonB
  validationSummary Json                @db.JsonB
  areaCount         Int                 @default(0)
  quarterlyRowCount Int                 @default(0)
  activatedAt       DateTime?
  failedAt          DateTime?
  failureReason     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  areas             MarketArea[]
  industries        Industry[]

  @@index([status, activatedAt])
  @@map("market_releases")
}

// Commercial area attributes come from the area (boundary attribute) file only.
// Boundaries themselves are never stored.
model MarketArea {
  id           String            @id @default(cuid())
  releaseId    String
  areaType     String
  areaCode     String
  sourceName   String
  observedName String?
  areaTypeName String
  districtCode String
  districtName String
  createdAt    DateTime          @default(now())
  release      MarketRelease     @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  quarterly    MarketQuarterly[]

  @@unique([releaseId, areaType, areaCode])
  @@index([releaseId, districtCode, areaCode])
  @@map("market_areas")
}

// Registry of every service-industry code found in the source files. Only codes
// marked supported are exposed and imported into market_quarterly.
model Industry {
  releaseId             String
  code                  String
  sourceName            String
  displayName           String
  displayNameSource     String
  sourceCategoryVersion String
  isSupported           Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  release               MarketRelease     @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  quarterly             MarketQuarterly[]

  @@id([releaseId, code])
  @@index([releaseId, isSupported])
  @@map("industries")
}

// Observed quarterly indicator per join key. A null value means the source did
// not provide that indicator and is never replaced with 0.
model MarketQuarterly {
  id                        String        @id @default(cuid())
  releaseId                 String
  quarter                   String
  areaType                  String
  areaCode                  String
  industryCode              String
  salesAmount               Decimal?      @db.Decimal(18, 0)
  storeCount                Int?
  similarIndustryStoreCount Int?
  franchiseStoreCount       Int?
  openedStoreCount          Int?
  closedStoreCount          Int?
  createdAt                 DateTime      @default(now())
  area                      MarketArea    @relation(fields: [releaseId, areaType, areaCode], references: [releaseId, areaType, areaCode], onDelete: Cascade)
  industry                  Industry      @relation(fields: [releaseId, industryCode], references: [releaseId, code], onDelete: Cascade)

  @@unique([releaseId, quarter, areaType, areaCode, industryCode])
  @@index([releaseId, areaCode, industryCode, quarter])
  @@index([releaseId, industryCode])
  @@map("market_quarterly")
}
